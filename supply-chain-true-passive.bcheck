  end if

  if {to_lower(latest.response)} matches "cdn\.jsdelivr\.net/npm/(?:@[^/\"'\s<>]+/[^@/\"'\s<>]+|[^@/\"'\s<>]+)(?:/|[?#\"'\s<>]|$)" then
    report issue and continue:
      name: "[Supply Chain] jsDelivr npm dependency appears versionless"
      severity: info
      confidence: tentative
      remediation: "Pin an exact package version in the CDN URL and add SRI. Avoid versionless public CDN imports for production assets."
      detail: `The response appears to reference a jsDelivr npm package URL without an exact version in the package segment. Versionless CDN imports are mutable and make review, rollback, and SRI harder. Matched passively in the response for: {latest.request.url}`
  end if

  if {to_lower(latest.response)} matches "unpkg\.com/(?:@[^/\"'\s<>]+/[^@/\"'\s<>]+|[^@/\"'\s<>]+)(?:/|[?#\"'\s<>]|$)" then
    report issue and continue:
      name: "[Supply Chain] unpkg dependency appears versionless"
      severity: info
      confidence: tentative
      remediation: "Pin an exact package version in the CDN URL and add SRI where practical. Avoid versionless public CDN imports for production assets."
      detail: `The response appears to reference an unpkg package URL without an exact version in the package segment. Versionless CDN imports are mutable and make review, rollback, and SRI harder. Matched passively in the response for: {latest.request.url}`
  end if

  if {to_lower(latest.response)} matches "esm\.sh/(?:@[^/\"'\s<>]+/[^@/\"'\s<>]+|[^@/\"'\s<>]+)(?:/|[?#\"'\s<>]|$)" then
    report issue and continue:
      name: "[Supply Chain] esm.sh dependency appears versionless"
      severity: info
      confidence: tentative
      remediation: "Pin an exact package version. Avoid versionless public CDN imports for production assets."
