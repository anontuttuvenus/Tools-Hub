  end if

  if {to_lower(latest.response)} matches "skypack\.dev/(?:@[^/\"'\s<>]+/[^@/\"'\s<>]+|[^@/\"'\s<>]+)(?:/|[?#\"'\s<>]|$)" then
    report issue and continue:
      name: "[Supply Chain] Skypack dependency appears versionless"
      severity: info
      confidence: tentative
      remediation: "Pin an exact package version. Avoid versionless public CDN imports for production assets."
      detail: `The response appears to reference a Skypack package URL without an exact version in the package segment. Versionless CDN imports are mutable and make review and rollback harder. Matched passively in the response for: {latest.request.url}`
  end if

  if {to_lower(latest.response)} matches "cdn\.jsdelivr\.net/gh/[^\"'\s<>@]+/[^\"'\s<>@]+(?:/|[?#\"'\s<>]|$)" then
    report issue and continue:
