      detail: `The response appears to reference a jsDelivr GitHub URL without an explicit version, tag, or commit in the URL. This can make browser-loaded code mutable. Matched passively in the response for: {latest.request.url}`
  end if

  #############################################################
  # Cluster 5: Source-control or raw-file JavaScript hosting.
  # These are not necessarily malicious, but they are risky for
  # production browser-executed dependencies.
  #############################################################

  if ({to_lower(latest.response.headers)} matches "content-type:\s*(?:text/html|application/xhtml\+xml)" or {to_lower(latest.response.body)} matches "<!doctype html|<html|<script") and {to_lower(latest.response.body)} matches "<script\b(?=[^>]*\bsrc\s*=\s*['\"](?:https?:)?//(?:raw\.githubusercontent\.com|gist\.githubusercontent\.com|rawcdn\.githack\.com|cdn\.rawgit\.com|rawgit\.com)/)[^>]*>" then
    report issue and continue:
      name: "[Supply Chain] Script loaded from raw source-control hosting"
      severity: info
      confidence: firm
      remediation: "Avoid loading production JavaScript from raw source-control URLs. Publish reviewed releases to a controlled artifact store or trusted CDN, pin immutable versions, and use SRI."
      detail: `The HTML response appears to load browser-executed JavaScript from raw source-control hosting. These URLs are often mutable or outside normal release review controls. Matched passively in the response for: {latest.request.url}`
  end if

  if ({to_lower(latest.response.headers)} matches "content-type:\s*(?:text/html|application/xhtml\+xml)" or {to_lower(latest.response.body)} matches "<!doctype html|<html|<script") and {to_lower(latest.response.body)} matches "<script\b(?=[^>]*\bsrc\s*=\s*['\"](?:https?:)?//[^'\"/]+\.github\.io/)[^>]*>" then
    report issue and continue:
      name: "[Supply Chain] Script loaded from GitHub Pages"
      severity: info
      confidence: tentative
      remediation: "Review whether GitHub Pages is an approved production script source. Prefer controlled artifact hosting, exact version pinning, and SRI for browser-executed dependencies."
      detail: `The HTML response appears to load JavaScript from a github.io host. This may be legitimate, but it should be reviewed as a third-party script supply-chain dependency. Matched passively in the response for: {latest.request.url}`
  end if

  #############################################################
  # Cluster 6: Dynamic remote JavaScript loading patterns.
  # These are heuristic findings for manual review.
  #############################################################

  if {to_lower(latest.response.body)} matches "import\s*\(\s*['\"]https?://" then
    report issue and continue:
      name: "[Supply Chain] Dynamic import from remote URL"
      severity: info
      confidence: tentative
      remediation: "Review dynamic remote imports. Prefer bundling reviewed dependencies, using import maps with pinned versions, and applying strict CSP controls."
      detail: `The response body contains a dynamic import() call that appears to import from an absolute remote URL. This can create a runtime supply-chain dependency that is harder to inventory and protect with SRI. Matched passively in the response for: {latest.request.url}`
  end if

  if {to_lower(latest.response.body)} matches "importscripts\s*\(\s*['\"]https?://" then
    report issue and continue:
      name: "[Supply Chain] Worker importScripts from remote URL"
      severity: info
      confidence: tentative
      remediation: "Review remote importScripts usage in workers and service workers. Prefer same-origin reviewed assets with version control and CSP restrictions."
